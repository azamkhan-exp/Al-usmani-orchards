# -----------------------------------------------------------------------------
# AL USMANI ORCHARDS (باغات آل عثمانی) — ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------

# Application URL (Used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographic HMAC-SHA256 Secret for Edge Session Token Signatures (Min 32 characters)
SESSION_SECRET=auo-production-grade-hmac-sha256-session-secret-salt-1934-multan

# Single Authoritative Owner Email (Receives SUPER_ADMIN role automatically)
ADMIN_OWNER_EMAIL=admin@alusmaniorchards.pk

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Transactional Email (SMTP) Configuration (Optional - falls back to simulated logging)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_NAME="Al Usmani Orchards"
SMTP_FROM_EMAIL=orders@alusmaniorchards.pk
ADMIN_ALERT_EMAIL=admin@alusmaniorchards.pk
